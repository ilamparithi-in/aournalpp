<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive encrypted credentials from legacy auto-backup -->
    <exclude domain="sharedpref" path="secure_cloud_credentials.xml" />
    <!-- Exclude native rootfs, databases, and internal runtime files -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>