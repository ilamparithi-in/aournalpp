<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow all cleartext HTTP traffic across the app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- System CA store -->
            <certificates src="system" />
            <!-- User-installed CA store to support self-hosted internal servers with custom CAs -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext HTTP only on loopback / local dev emulator endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
