# Android / Gradle build outputs
.gradle/
build/
**/build/
captures/
.externalNativeBuild/
**/.externalNativeBuild/
.cxx/
**/.cxx/
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# Signing keys & keystores (never commit release keys)
*.keystore
*.jks
*.p12
*.pfx

# Local properties & SDK configs
local.properties

# IDEs and Editors
.idea/
*.iml
.vscode/
*.ipr
*.iws

# Kotlin & JVM
.kotlin/
*.log
*.hprof

# Python & tools
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db

# Generated runtime assets & binaries across all modules and flavors
**/src/*/assets/bootstrap.tar.xz
**/src/*/assets/bin/
**/src/*/assets/lib/
scripts/*-arm64
scripts/*-x86_64
scripts/*.so
scripts/*.o
scripts/keys/
*.gpg

