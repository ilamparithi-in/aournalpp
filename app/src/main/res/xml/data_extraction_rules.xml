<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive encrypted credentials from cloud backup -->
        <exclude domain="sharedpref" path="secure_cloud_credentials.xml" />
        <!-- Exclude native linux rootfs, databases, and internal runtime files -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Hardware-backed Keystore keys are non-migratable; exclude encrypted prefs to avoid AEADBadTagException -->
        <exclude domain="sharedpref" path="secure_cloud_credentials.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>